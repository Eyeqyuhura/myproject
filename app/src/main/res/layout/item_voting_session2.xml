<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Corner.Left"

    android:outlineAmbientShadowColor="@color/colorGray"
    android:outlineSpotShadowColor="@color/colorGray"
    app:cardBackgroundColor="@color/black"
    android:clickable="true"
    app:cardCornerRadius="5dp"
    app:cardElevation="7dp"
    android:layout_width="match_parent"
    android:layout_margin="10dp"
    android:layout_height="250dp"
    >
    <RelativeLayout
        android:id="@+id/sessionCard2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_border2"
        android:layout_margin="5dp"
        android:paddingVertical="10dp"
        >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"

        >

        <TextView
            android:id="@+id/sessionTitleTv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            android:layout_marginTop="30dp"
            android:textColor="@color/black"
            android:textAllCaps="true"
            android:text="Title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/sessionLevelTv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold|italic"
            android:text="Level"
            app:layout_constraintStart_toStartOf="@+id/sessionTitleTv2"
            app:layout_constraintTop_toBottomOf="@+id/sessionTitleTv2" />

        <TextView
            android:id="@+id/sessionSchedualTv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textStyle="bold|italic"
            android:text="Schedual"
            app:layout_constraintStart_toStartOf="@+id/sessionLevelTv2"
            app:layout_constraintTop_toBottomOf="@+id/sessionLevelTv2" />

        <Button
            android:id="@+id/toVoteBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:background="@drawable/buttonbackground2"
            android:text="vote"
            tools:visibility="visible"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/toResultBtn" />

        <Button
            android:id="@+id/toResultBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/buttonbackground2"
            android:text="results"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>