<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Material3.Corner.Left"

    android:outlineAmbientShadowColor="@color/colorGray"
    android:outlineSpotShadowColor="@color/colorGray"
    android:layout_width="match_parent"
    android:layout_margin="10dp"
    android:layout_height="180dp"
    >
    <RelativeLayout
        android:id="@+id/sessionCard2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_border3"
        android:layout_margin="5dp"
        android:paddingVertical="10dp"
        >
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/studentNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="15dp"
        android:text="Student Name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/studentRegNoTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="15dp"
        android:textStyle="bold"
        android:text="Student RegNo"
        app:layout_constraintStart_toStartOf="@+id/studentNameTv"
        app:layout_constraintTop_toBottomOf="@+id/studentNameTv" />

    <Button
        android:id="@+id/acceptBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="@dimen/space_from_top"
        android:background="@drawable/buttonbackground"
        android:text="Accept"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/rejectBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="@dimen/space_from_top"
        android:background="@drawable/buttonbackground3"
        android:text="Reject"
        app:layout_constraintBottom_toBottomOf="@+id/acceptBtn"
        app:layout_constraintStart_toEndOf="@+id/acceptBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>